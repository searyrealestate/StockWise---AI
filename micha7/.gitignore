# Runtime state and outputs (exclude contents, keep placeholder)
state/*
!state/.gitkeep
outputs/*
!outputs/.gitkeep

# Private config values (config.json schema is committed; values are local)
config.local.json

# Logs and temp
*.log
*.tmp
*.bak

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
build/
dist/

# Virtual environments
.venv/
venv/
env/
